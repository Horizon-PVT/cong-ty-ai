{
  "policy_id": "email-live-pilot-harness-policy",
  "milestone": "1.0U",
  "default_mode": "EMAIL_LIVE_PILOT_HARNESS_ONLY",
  "live_email_enabled": false,
  "emergency_stop": true,
  "hard_locks": {
    "no_real_email_send": true,
    "no_gmail_api_call": true,
    "no_smtp_call": true,
    "no_provider_api_call": true,
    "no_external_http_request": true,
    "no_fetch": true,
    "no_axios": true,
    "no_sendMail": true,
    "no_nodemailer_transport_send": true,
    "no_process_env_read": true,
    "no_env_file_read": true,
    "no_secrets": true,
    "no_customer_communication": true,
    "no_crm_update": true,
    "no_payment_request": true,
    "no_contract_send": true,
    "no_browser_automation": true,
    "no_deploy": true,
    "no_publish": true,
    "no_production_mutation": true,
    "no_merge_without_owner_token": true
  },
  "token_separation_policy": {
    "merge_token_name": "OWNER_APPROVED_MERGE_PR",
    "sandbox_token_name": "OWNER_APPROVED_EMAIL_SANDBOX_TOKEN",
    "future_live_token_name": "OWNER_APPROVED_LIVE_TOKEN",
    "future_pilot_token_format": "OWNER_APPROVED_LIVE_TOKEN=<pilot_action_id>",
    "merge_token_must_not_enable_live_pilot": true,
    "sandbox_token_must_not_enable_live_pilot": true,
    "future_live_token_reserved_only": true,
    "one_token_one_pilot_action": true,
    "token_scope": "PILOT_ACTION_ID",
    "token_expires_after_use": true,
    "token_must_match_action_id": true
  },
  "pilot_constraints": {
    "max_pilot_actions": 1,
    "recipient_kind_required": "OWNER_ALLOWLIST_PLACEHOLDER",
    "recipient_is_customer_allowed": false,
    "provider_status_required": "FAKE_LOCAL_ONLY",
    "retry_policy_required": "DISABLED",
    "duplicate_send_protection_required": true,
    "kill_switch_active_required": true
  },
  "required_safety_warning_lines": [
    "LIVE PILOT NOT ENABLED",
    "HARNESS ONLY",
    "NOT SENT",
    "OWNER ALLOWLIST ONLY",
    "NO REAL CUSTOMER CONTACT",
    "NO GMAIL API CALL",
    "NO SMTP CALL",
    "NO PROVIDER API CALL",
    "NO CRM UPDATE",
    "NO PAYMENT REQUEST",
    "FAKE PROVIDER ONLY",
    "FUTURE LIVE TOKEN REQUIRED",
    "KILL SWITCH ACTIVE"
  ]
}
