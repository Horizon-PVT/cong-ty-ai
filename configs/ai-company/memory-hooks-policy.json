{
  "milestone": "5.1B",
  "default_mode": "dry_run",
  "hooks": {
    "supported_events": ["pre_run_hydrate", "post_run_capture", "manual_capture"],
    "playbook_min_quality_score": 0.8
  },
  "assertions": {
    "pre_run_hydrate_loads_context": true,
    "post_run_capture_extracts_facts": true,
    "manual_capture_saves_correctly": true,
    "successful_run_creates_playbook": true,
    "repeated_blockers_propose_config_updates": true,
    "learning_recommends_skill_updates": true,
    "hook_operations_log_provenance": true,
    "hooks_enforce_read_tenant_isolation": true,
    "hooks_enforce_write_tenant_isolation": true,
    "regression_chain_integrity_verified": true
  },
  "allowed_modes": ["dry_run", "live"],
  "required_live_token_prefix": "OWNER_APPROVED_LEARNING_TOKEN="
}
