{
  "milestone": "1.1B",
  "default_crm_write_enabled": false,
  "allowed_providers": ["dry_run", "hubspot", "salesforce"],
  "allowed_modes": ["dry_run", "sandbox", "live"],
  "default_mode": "dry_run",
  "live_requires_owner_token": true,
  "sandbox_requires_owner_token": true,
  "consent_check_required": true,
  "suppression_check_required": true,
  "idempotency_required": true,
  "redaction_required": true,
  "retry_default": "disabled",
  "provider_secret_sources": ["env", "paperclip_company_secret_ref"],
  "hubspot_config": {
    "object_mode": "contact_company_deal",
    "pilot_mode": "test_portal",
    "api_version": "v3",
    "idempotency_strategy": "search_before_create",
    "external_property": "paperclip_idempotency_key"
  },
  "salesforce_config": {
    "object_mode": "Lead",
    "pilot_mode": "sandbox",
    "idempotency_strategy": "query_by_email_hash",
    "external_id_note": "Full robust idempotency requires custom field Paperclip_Action_Id__c"
  },
  "token_format": "OWNER_APPROVED_CRM_WRITE_TOKEN=crm_action_<id>_1_1b_<provider>_<mode>",
  "hard_locks": {
    "no_live_write_without_owner_token": true,
    "no_write_to_suppressed_recipient": true,
    "no_raw_provider_secret_in_artifacts": true,
    "no_raw_email_in_committed_artifacts": true
  },
  "valid_scorecard_verdicts": [
    "CRM_PROVIDER_READY_DRY_RUN_ONLY",
    "CRM_PROVIDER_SANDBOX_WRITE_SUCCEEDED",
    "CRM_PROVIDER_LIVE_WRITE_SUCCEEDED",
    "CRM_PROVIDER_WRITE_BLOCKED_PENDING_OWNER_APPROVAL",
    "CRM_PROVIDER_CONFIG_MISSING",
    "CRM_PROVIDER_WRITE_FAILED_RETRYABLE",
    "CRM_PROVIDER_WRITE_FAILED_FINAL",
    "HOLD_FOR_DATA_QUALITY_REVIEW"
  ]
}
