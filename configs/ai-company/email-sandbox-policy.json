{
  "policy_id": "email_sandbox_policy_1_0s",
  "milestone": "1.0S",
  "description": "Safety policy and sandbox boundaries for AI Company OS Owner-Approved Email Send Sandbox",
  "department_led": true,
  "default_mode": "EMAIL_SANDBOX_ONLY",
  "token_separation_policy": {
    "merge_token_name": "OWNER_APPROVED_MERGE_PR",
    "live_action_token_name": "OWNER_APPROVED_LIVE_TOKEN",
    "sandbox_token_name": "OWNER_APPROVED_EMAIL_SANDBOX_TOKEN",
    "merge_token_must_not_enable_live_actions": true,
    "live_action_token_must_not_merge_code": true,
    "live_token_not_accepted_for_sending": true
  },
  "sandbox_token_model": {
    "sandbox_token_name": "OWNER_APPROVED_EMAIL_SANDBOX_TOKEN",
    "required_token_scope": "ACTION_ID",
    "required_token_format_example": "OWNER_APPROVED_EMAIL_SANDBOX_TOKEN=<action_id>",
    "one_token_one_email_action": true,
    "token_expires_after_use": true,
    "merge_token_not_accepted": true,
    "live_token_not_accepted_for_sending": true
  },
  "hard_locks": {
    "no_real_email_send": true,
    "no_gmail_api_call": true,
    "no_smtp_call": true,
    "no_sendgrid_mailgun_resend_api_call": true,
    "no_external_http_request": true,
    "no_fetch": true,
    "no_axios": true,
    "no_sendmail": true,
    "no_nodemailer_transport_send": true,
    "no_process_env_read": true,
    "no_env_read_or_touch": true,
    "no_secrets": true,
    "no_customer_communication": true,
    "no_crm_update": true,
    "no_payment_request": true,
    "no_contract_send": true,
    "no_browser_automation": true,
    "no_login_cookie_session_usage": true,
    "no_scraping": true,
    "no_paid_tools": true,
    "no_spending": true,
    "no_deploy": true,
    "no_publish": true,
    "no_production_mutation": true,
    "no_merge_without_owner_token": true
  },
  "departments": [
    "CEO",
    "COO",
    "Sales_AI",
    "CMO",
    "CTO",
    "CFO",
    "Customer_Success_AI",
    "QA",
    "CLO_Hermes",
    "Research_AI"
  ]
}
