{
  "policy_id": "email-boss-allowlist-test-gate-policy",
  "milestone": "1.0V",
  "default_mode": "EMAIL_BOSS_ALLOWLIST_TEST_GATE_ONLY",
  "live_email_enabled": false,
  "emergency_stop": true,
  "hard_locks": {
    "no_real_email_send": true,
    "no_gmail_api_call": true,
    "no_smtp_call": true,
    "no_provider_api_call": true,
    "no_external_http_request": true,
    "no_fetch": true,
    "no_axios": true,
    "no_sendMail": true,
    "no_nodemailer_transport_send": true,
    "no_process_env_read": true,
    "no_env_file_read": true,
    "no_secrets": true,
    "no_customer_communication": true,
    "no_crm_update": true,
    "no_payment_request": true,
    "no_contract_send": true,
    "no_browser_automation": true,
    "no_deploy": true,
    "no_publish": true,
    "no_production_mutation": true,
    "no_merge_without_owner_token": true
  },
  "token_policy": {
    "merge_token_name": "OWNER_APPROVED_MERGE_PR",
    "sandbox_token_name": "OWNER_APPROVED_EMAIL_SANDBOX_TOKEN",
    "future_live_token_name": "OWNER_APPROVED_LIVE_TOKEN",
    "future_pilot_token_format": "OWNER_APPROVED_LIVE_TOKEN=<pilot_action_id>",
    "merge_token_must_not_enable_live_test": true,
    "sandbox_token_must_not_enable_live_test": true,
    "future_live_token_reserved_only": true,
    "one_token_one_test_action": true,
    "token_scope": "PILOT_ACTION_ID",
    "token_expires_after_use": true,
    "token_must_match_action_id": true
  },
  "test_gate_constraints": {
    "max_test_actions": 1,
    "recipient_kind_required": "BOSS_ALLOWLIST_RUNTIME_ONLY",
    "recipient_is_customer_allowed": false,
    "recipient_email_in_repo_allowed": false,
    "provider_status_in_pr_required": "FAKE_LOCAL_ONLY",
    "provider_ready_in_pr_allowed": false,
    "retry_policy_required": "DISABLED",
    "duplicate_send_protection_required": true,
    "kill_switch_required": true,
    "kill_switch_active_in_pr_required": true
  },
  "required_safety_warning_lines": [
    "LIVE TEST SEND NOT ENABLED IN PR",
    "BOSS ALLOWLIST ONLY",
    "NOT SENT",
    "ONE EMAIL ONLY",
    "NO REAL CUSTOMER CONTACT",
    "NO GMAIL API CALL IN PR",
    "NO SMTP CALL IN PR",
    "NO PROVIDER API CALL IN PR",
    "NO CRM UPDATE",
    "NO PAYMENT REQUEST",
    "RUNTIME LIVE TOKEN REQUIRED",
    "RETRY DISABLED",
    "DUPLICATE SEND PROTECTION REQUIRED",
    "KILL SWITCH REQUIRED"
  ]
}
